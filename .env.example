# DataDecay-X Environment Configuration Example
# Copy this file to .env and fill in your values

# Optional: Override database path
# DATADECAY_DB_PATH=data/datadecay.db

# Optional: Override log level (DEBUG, INFO, WARNING, ERROR)
# DATADECAY_LOG_LEVEL=INFO

# Optional: MLflow tracking URI (only if MLflow is enabled)
# MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: Override random seed
# DATADECAY_SEED=42
